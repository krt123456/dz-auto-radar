[Unit]
Description=Hourly official vehicle auction refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/sonardeals-radar/auction_refresh.sh
User=root
Group=root
Nice=8
TimeoutStartSec=3h
KillMode=control-group
TimeoutStopSec=2m
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
TasksMax=1024
ReadWritePaths=/var/lib/sonardeals-radar /home/krt/car_deal_finder /home/krt/eu_harvest /srv/sonardeals-radar /run/lock /var/tmp
