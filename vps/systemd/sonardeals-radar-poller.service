[Unit]
Description=SonarDeals radar secure refresh queue consumer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sonardeals-radar/radar_poller.py
Restart=always
RestartSec=10
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
TasksMax=256
ReadWritePaths=/var/lib/sonardeals-radar /home/krt/car_deal_finder /home/krt/eu_harvest /srv/sonardeals-radar /run/lock /var/tmp

[Install]
WantedBy=multi-user.target
