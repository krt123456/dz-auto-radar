[Unit]
Description=SonarDeals loopback WAF-solving browser fetch daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sonardeals-radar/waf_fetch_daemon.py --port 8977
User=root
Group=root
Restart=always
RestartSec=20
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
