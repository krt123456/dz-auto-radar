[Unit]
Description=SonarDeals scheduled smart radar refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/sonardeals-radar/radar_refresh.sh smart scheduled-smart
User=root
Group=root
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
TimeoutStartSec=6h
KillMode=control-group
TimeoutStopSec=2m
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
OOMScoreAdjust=200
TasksMax=8192
ReadWritePaths=/var/lib/sonardeals-radar /home/krt/car_deal_finder /home/krt/eu_harvest /srv/sonardeals-radar /run/lock /var/tmp
